---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Contacto Hostería Roble Sur || El Calafate, Patagonia Argentina" description="Realizamos tu reserva online o te atendemos por teléfono, email o whatsapp.">
<hr />
<main class="reservas">
    <section class="section-flex-res reservas__section">
        <article class="flex-reservas reservas__titulo">
            <h1 class="titulo__secundario titulo__secundario--reservas reservas__titulo--secundario">
                Contacto
            </h1>
            <div class="img-reservas reservas__img"></div>
        </article>
        <form class="reservas__form reservas__form--mobile reservas__form--desktop" id="contactForm">
            <label for="nombre" class="display-none">Nombre</label>
            <input type="text" id="nombre" placeholder="Nombre y apellido" class="form" name="nombre" />

            <div>
                <label class="reservas__date" for="checkin">Check In</label>
                <input type="date" id="checkin" class="form" name="checkIn" />
            </div>

            <div>
                <label class="reservas__date" for="checkout">Check Out</label>
                <input type="date" id="checkout" class="form" name="checkOut" />
            </div>

            <label for="email" class="display-none">E-mail</label>
            <input type="email" id="email" placeholder="E-mail" class="form" name="email" />

            <label for="mensaje-reserva" class="display-none">Mensaje</label>
            <textarea id="mensaje-reserva" cols="30" rows="10" placeholder="Mensaje" name="text"></textarea>

            <label for="number" class="display-none"></label>
            <input type="text" id="number" class="form" name="phoneNumber" placeholder="Teléfono" />
            <div class="reservas__checkbox">
                <label for="checkbox">Quiero que me llamen por teléfono</label>
                <input type="checkbox" name="checkbox" id="checkbox" />
            </div>

            <div class="reservas__botones">
                <button type="submit" id="registerButton" class="boton">Enviar</button>
                <!-- <input type="submit" value="Enviar" class="boton"> -->
                <input type="reset" value="Borrar" class="boton" />
            </div>
        </form>
    </section>
</main>
<script>
  import { initContactForm } from '../lib/contact-form';
  initContactForm();
</script>
</Layout>
