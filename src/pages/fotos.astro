---
import Layout from '../layouts/Layout.astro';
import 'animate.css';
---

<Layout title="Galeria de fotos de la Hostería Roble Sur" description="Las fotos más impresionantes de El Calafate y la Hostería Roble Sur.">
<hr />
<section class="galeria">
    <div class="contenedor">
        <h1>Fotos</h1>
        <div class="galeria__uno animate__animated animate__slideInLeft animate__slow">
            <img loading="lazy" src="/img/galeria/12.jpg" alt="Baños de uso común">
            <img loading="lazy" src="/img/galeria/16.jpg" alt="Baños de uso común">
        </div>
        <div class="galeria__dos animate__animated animate__slideInRight animate__delay-1s animate__slower">
            <img loading="lazy" src="/img/galeria/17.jpg" alt="Escritorio junto a la ventana">
            <img loading="lazy" src="/img/galeria/2.jpg" alt="Entrada a la hostería">
            <img loading="lazy" src="/img/galeria/22.jpg" alt="La Hostería con el Cerro Calafate al fondo">
        </div>
        <div class="galeria__tres animate__animated animate__slideInLeft animate__delay-2s animate__slower">
            <img loading="lazy" src="/img/galeria/23.jpg" alt="Comedor interno">
            <img loading="lazy" src="/img/galeria/27.jpg" alt="Sillones y lugar encuentro">
        </div>
        <div class="galeria__cuatro animate__animated animate__slideInRight animate__delay-3s animate__slower">
            <img loading="lazy" src="/img/galeria/28.jpg" alt="La Hostería con el Cerro Calafate y la luna al fondo">
            <img loading="lazy" src="/img/galeria/3.jpg" alt="Recepción de la hostería">
            <img loading="lazy" src="/img/galeria/4.jpg" alt="La Hostería con el Cerro Calafate al fondo">
        </div>
        <div class="galeria__cinco animate__animated animate__slideInLeft animate__delay-4s animate__slower">
            <img loading="lazy" src="/img/galeria/5.jpg" alt="La Hostería con el Lago Argentino al fondo">
            <img loading="lazy" src="/img/galeria/6.jpg" alt="Comedor con ventalnales al patio y al Cerro Calafate">
        </div>
    </div>
</section>

</Layout>
