---
import Layout from '../layouts/Layout.astro';
---

<Layout title="El Calafate, Patagonia Argentina | Ubicación Hostería Roble Sur" description="Ubicados en una zona de vista privilegiada al Lago Argentino, Cerro Calafate y a al pueblo">
<hr />
<main class="ubicacion">
    <h1 class="titulo__secundario titulo__secundario--ubica">Ubicación</h1>
    <iframe class="ubicacion__mapa--mobile"
        src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d395075.837949193!2d-73.48883620601522!3d-50.243002710068225!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0xbdbb9f5c2a217d39%3A0x3394a1174ae6ec55!2sRoble%20Sur!5e1!3m2!1ses-419!2sar!4v1684595364994!5m2!1ses-419!2sar"
        width="600" height="450" style="border:0;" allowfullscreen="" loading="lazy"
        referrerpolicy="no-referrer-when-downgrade"></iframe>
    <p class="ubicacion__parrafo">Calle Glaciar Río Túnel 210 <br> El Calafate <br> Provincia de Santa Cruz<br>
        República Argentina</p>
</main>
</Layout>
